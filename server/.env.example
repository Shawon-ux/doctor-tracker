NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker
# At least 32 random characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
JWT_TTL_HOURS=8
# Origin(s) of the Next.js client, comma separated
CLIENT_ORIGIN=http://localhost:3000
# Hops of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY=1
LOG_LEVEL=info
# Used only by `npm run seed` to create the first admin
ADMIN_EMAIL=admin@doctortracker.dev
ADMIN_PASSWORD=ChangeMe!2026
# Optional read-only account created by the seed
VIEWER_EMAIL=viewer@doctortracker.dev
VIEWER_PASSWORD=ViewOnly!2026
# Database name used when MONGODB_URI has none (default: doctor-tracker)
DB_NAME=doctor-tracker
